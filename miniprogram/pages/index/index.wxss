/* 全局背景微光 */
.light-bg {
  position: fixed;
  pointer-events: none;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(46, 204, 113, 0.1) 0%, transparent 70%);
  z-index: -1;
}

.container {
  padding: 40rpx;
  min-height: 100vh;
  position: relative;
  background: var(--bg-gradient-light) !important;
}

/* 标题组设计 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 60rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
}

.sub-title {
  font-size: 20rpx;
  color: #2ecc71;
  letter-spacing: 4rpx;
  font-weight: bold;
}

/* 科技感创建按钮 */
.add-btn {
  margin: 0 !important;
  background: #2ecc71 !important;
  color: white !important;
  border-radius: 40rpx !important;
  font-size: 26rpx !important;
  padding: 16rpx 40rpx !important;
  box-shadow: 0 12rpx 24rpx rgba(46, 204, 113, 0.25);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.circle-arrow {
  width: 52rpx;
  height: 52rpx;
  /* 将原本的浅灰色边框改为浅绿色，稍微加粗一点点增加存在感 */
  border: 4rpx solid rgba(169, 240, 169, 0.8); 
  border-radius: 50%;
  position: relative;
  background: rgba(255, 255, 255, 0.4); /* 给圆圈加一点极淡的白色底，更清晰 */
}

.circle-arrow::after {
  content: "→";
  /* 箭头符号颜色改为更明显的深嫩绿色，方便看清 */
  color: #79d392; 
  position: absolute;
  top: 50%; 
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  font-weight: bold;
}

/* 悬浮/点击时的效果，让它更有反馈感 */
.card-hover .circle-arrow {
  background: #A9F0A9; /* 点击时背景变成浅绿色 */
  border-color: #79d392;
}

.card-hover .circle-arrow::after {
  color: white; /* 点击时箭头变白色 */
}
.btn-hover {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 10rpx rgba(46, 204, 113, 0.2);
}

/* 玻璃拟态卡片核心 */
.album-card {
  background: rgba(255, 255, 255, 0.6) !important;
  position: relative;
  margin-bottom: 34rpx;
  border-radius: 48rpx; /* 约 32px */
  overflow: hidden;
  transition: all 0.4s;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.03); /* 柔和阴影 */
}

.glass-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx); /* 磨砂玻璃效果 */
  z-index: 1;
}

.card-content {
  position: relative;
  z-index: 2;
  padding: 50rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.album-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 16rpx;
  display: block;
}

.member-tag {
  font-size: 22rpx;
  color: #2ecc71;
  background: rgba(46, 204, 113, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-weight: 600;
}

.card-hover {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.5);
}

/* 线框图标装饰 */
.circle-arrow {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 50%;
  position: relative;
}

.circle-arrow::after {
  content: "→";
  color: #bdc3c7;
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
}