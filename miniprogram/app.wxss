/* app.wxss */
page {
  /* ✨ 核心修改：定义更浅、更柔和、透亮的马卡龙七彩渐变色 */
  --logo-gradient: linear-gradient(135deg, #f9acac, #FFE5B4, #b3ebb3, #a5c5ec, #d89ffb);
  
  /* 定义一个极淡的渐变作为全屏背景水印 (带透明度) */
  --bg-gradient-light: linear-gradient(135deg, rgba(255,153,153, 0.2), 
  rgba(255,213,158, 0.2), 
  rgba(169,240,169, 0.2), 
  rgba(163,206,255, 0.2), 
  rgba(209,163,255, 0.2));

  /* 基础文字颜色 */
  --light-text: #ecf0f1;
  color: #2c3e50;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  
  /* 设置基础背景色为纯净白，更有利于浅色渐变的透亮感 */
  background-color: #ffffff; 
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 玻璃拟态基础样式 (增强透明感，降低阴影) */
.glass-effect {
  background: rgba(255, 255, 255, 0.6) !important; /* 提高背景透明度 */
  backdrop-filter: blur(20px); /* 增强模糊效果，更有高级感 */
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.4) !important; /* 边框更淡 */
  box-shadow: 0 8rpx 32rpx 0 rgba(31, 38, 135, 0.04) !important; /* 阴影更淡 */
}